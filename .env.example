# Local development: connect to MongoDB on the host.
MONGO_URI=mongodb://localhost:27017/leadflow

# Docker Compose MongoDB credentials.
# Replace the password with a long, URL-safe value before deployment.
MONGO_ROOT_USERNAME=leadflow
MONGO_ROOT_PASSWORD=replace-with-a-long-url-safe-password

# Optional host port for the web app.
APP_PORT=3000
